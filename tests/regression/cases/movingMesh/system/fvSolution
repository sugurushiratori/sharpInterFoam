FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.water.*"
    {
        nAlphaCorr      2;
        nAlphaSubCycles 1;
	cAlpha	1;

	SCLSVOF
	{
		correctPsi	no;
		widthFactor	1.5;
		densityScaled	no;
		initializeAtanh	yes;
		denomDeltaTau	10.0;
		factorNumLoop	1.0;
		tolMagGradPsi	1e-5;
	}
	THINC
	{
		enable		yes;
		flux		yes;
		SW		yes;
	}

        MULESCorr       yes;
        nLimiterIter    3;

        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-13;
        relTol          0;
    }

    "pcorr.*"
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-13;
        relTol          0;
    }

	pcorrFinal
	{
		$pcorr;
		relTol	0;
	}



    p_rgh
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-12;
        relTol          1e-3;
    }

    p_rghFinal
    {
        $p_rgh;

        relTol          0;
    }

    "U.*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-13;
        relTol          0;
    }

    cellMotionUz
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-13;
        relTol          0;
    }

}

PIMPLE
{
    momentumPredictor   yes;
    nOuterCorrectors    10;
    nCorrectors		2;

    correctPhi			yes;
    checkMeshCourantNo		yes;
    moveMeshOuterCorrectors	no;

    nNonOrthogonalCorrectors	0;
    consistent			yes; // SIMPLEC

    residualControl
    {
	    "(p_rgh|U|alpha.water)"
	    {
		    relTol	0.0;
		    tolerance	1e-4;
	    }
    }
    
}

relaxationFactors
{
    equations
    {
        ".*"                1;
    }
}

