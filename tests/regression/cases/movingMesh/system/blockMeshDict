FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
convertToMeters 1;

#include "domainSize"

vertices
(
     (0   0.0  0)
     ($Lx 0.0  0)
     ($Lx $dy  0)
     (0   $dy  0)
     (0   0.0  $Lz)
     ($Lx 0.0  $Lz)
     ($Lx $dy  $Lz)
     (0   $dy  $Lz)

);

blocks
(
    hex (0 1 2 3 4 5 6 7) (100 1 10) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    frontBack
    {
        type empty;
        faces
        (
		(1 5 4 0)
		(3 7 6 2)
        );
    }
	
    bottom
    {
	type patch;
	faces
	(
		(0 3 2 1)
	);
    }

    top
    {
	type patch;
	faces
	(
		(7 4 5 6)
	);
    }

    side
    {
	type patch;
	faces
	(
		(0 4 7 3)
		(2 6 5 1)
	);
    }
);

mergePatchPairs
(
);




