FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// [kg m s K mol A cd]
dimensions      [0 0 0 1 0 0 0];


internalField   uniform 0.5;

boundaryField
{
    bottom { type fixedValue; value uniform 1; }
    top    { type fixedValue; value uniform 0; }
    "(left|right)" { type zeroGradient; }
    "(front|back)" { type empty; }
}

