FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases (water air);

water
{
    transportModel  NewtonianThermo;
    nu              1;
    rho             1;
    kappa           1.0;
}

air
{
    transportModel  NewtonianThermo;
    nu              1;
    rho             1;
    kappa           0.1;
}

sigma        0;
sigmaTemp    0;  

