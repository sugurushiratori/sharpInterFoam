FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     sharpInterThermoFoam;

//startFrom       startTime;
startFrom startTime;

startTime       0;

stopAt          endTime;

endTime 20;

deltaT 0.05;

writeControl    adjustableRunTime;

writeInterval 20;

purgeWrite      0;

writeFormat ascii;

writePrecision 15;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  no;

maxCo           0.25;
maxAlphaCo      0.25;

maxDeltaT       1;

functions
{
   #includeFunc solverInfo

   alphaIntegral
   {
      type		volFieldValue;
      libs		("libfieldFunctionObjects.so");
      fields		(alpha.water);
      valueOutput	false;
      writeFields	false;
      source		all;
      operation		volIntegrate;
      writeControl	timeStep;
   }
   fieldMinMax1
   {
      type		fieldMinMax;
      libs		("libfieldFunctionObjects.so");
      mode              magnitude;
      fields		(U);
      location          true;
      valueOutput	false;
      writeControl	timeStep;
   }
}

