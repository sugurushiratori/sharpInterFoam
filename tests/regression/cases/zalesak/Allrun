#!/bin/sh
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
runApplication blockMesh
cp 0/alpha.water.org 0/alpha.water
# evaluate the #codeStream initial field (reference for E_alpha)
runApplication -s alpha0 postProcess -fields '(alpha.water)' -func 'writeObjects(alpha.water)' -time 0
runApplication postProcess -func writeCellCentres -time 0
runApplication $(getApplication)
