FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     sharpInterFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         6.2832;

deltaT          0.0200102;

writeControl    adjustableRunTime;

writeInterval   6.2832;

purgeWrite      0;

writeFormat     ascii;

writePrecision  15;

writeCompression uncompressed;

timeFormat      general;

timePrecision   6;

runTimeModifiable no;

adjustTimeStep  no;

maxCo           1;

maxAlphaCo      1;

maxDeltaT       1;

functions
{
    alphaIntegral
    {
        type            volFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        fields          ( alpha.water );
        operation       volIntegrate;
        regionType      all;
        writeFields     false;
        writeControl    timeStep;
    }
}


