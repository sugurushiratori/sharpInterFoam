    (  5.0  0.0  $dz)
    (  5.0  2.0  $dz)
    (  0.0  2.0  $dz)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (400 160 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    bottom { type patch; faces ((0 1 5 4)); }
    top    { type patch; faces ((3 7 6 2)); }
    left   { type patch; faces ((0 4 7 3)); }
    right  { type patch; faces ((2 6 5 1)); }
    front  { type empty; faces ((0 3 2 1)); }
    back   { type empty; faces ((4 5 6 7)); }
);

