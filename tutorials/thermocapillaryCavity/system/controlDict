FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     sharpInterThermoFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         5;

deltaT          1e-5;

writeControl    adjustableRunTime;

writeInterval   0.5;

purgeWrite      0;

writeFormat     ascii;

writePrecision  16;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.25;

maxAlphaCo      0.25;

maxDeltaT       1;

functions
{
    solverInfo
    {
        type            solverInfo;
        libs            ( utilityFunctionObjects );
        writeControl    timeStep;
        writeInterval   1;
        fields          ( p U );
    }
    alphaIntegral
    {
        type            volFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        fields          ( alpha.water );
        valueOutput     false;
        writeFields     false;
        source          all;
        operation       volIntegrate;
        writeControl    timeStep;
    }
    alphaMinMax
    {
        type            fieldMinMax;
        libs            ( "libfieldFunctionObjects.so" );
        mode            magnitude;
        fields          ( alpha.water );
        location        false;
        writeControl    timeStep;
    }
    fieldMinMax1
    {
        type            fieldMinMax;
        libs            ( "libfieldFunctionObjects.so" );
        mode            magnitude;
        fields          ( U );
        location        true;
        valueOutput     false;
        writeControl    timeStep;
    }
}


