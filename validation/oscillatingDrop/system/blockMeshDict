FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Axisymmetric (wedge, axis = z) half domain r < 3, 0 < z < 3 with the
// symmetry plane z = 0, drop radius R = 1 at the origin.
n   25;                        // cells per drop radius
nc  #eval{ 3*$n };
xw  #eval{ 3.0*cos(degToRad(2.5)) };
yw  #eval{ 3.0*sin(degToRad(2.5)) };

vertices
(
    (0 0 0)
    ($xw #eval{-$yw} 0)
    ($xw $yw 0)
    (0 0 3)
    ($xw #eval{-$yw} 3)
    ($xw $yw 3)
);

blocks ( hex (0 1 2 0 3 4 5 3) ($nc 1 $nc) simpleGrading (1 1 1) );

boundary
(
    front  { type wedge; faces ((0 1 4 3)); }
    back   { type wedge; faces ((0 3 5 2)); }
    side   { type wall;  faces ((1 2 5 4)); }
    top    { type wall;  faces ((3 4 5 3)); }
    bottom { type symmetryPlane; faces ((0 2 1 0)); }
    axis   { type empty; faces ((0 3 3 0)); }
);
