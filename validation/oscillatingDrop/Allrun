#!/bin/sh
# Oscillating drop, mode l = 2, axisymmetric (Lamb; finite-viscosity
# correction of the damping rate).
#   ./Allrun [n]        n = cells per drop radius (default 25)
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
n=${1:-25}
sed -i "s/^n .*/n   $n;/" system/blockMeshDict
runApplication blockMesh
cp 0/alpha.water.org 0/alpha.water
runApplication $(getApplication)
python3 evaluate.py . || true
