#!/bin/sh
# Rising bubble benchmark (Hysing et al. 2009, test case 1).
#   ./Allrun [nx]       nx = cells per unit length (default 40)
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
nx=${1:-40}
sed -i "s/^nx .*/nx  $nx;/" system/blockMeshDict
runApplication blockMesh
cp 0/alpha.water.org 0/alpha.water
runApplication $(getApplication)
python3 evaluate.py . || true
