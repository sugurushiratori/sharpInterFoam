FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Axisymmetric (wedge, axis = z) domain r < 8, -8 < z < 8 (16 R) for a drop of
// radius R = 0.5 at the origin. Uniform cells of size h = R/n for r < 1 and
// |z| < 1, graded towards the outer walls.
n   12;                        // cells per drop radius R = 0.5
nf  #eval{ 2*$n };             // cells in a fine segment of length 1
xw  #eval{ 8.0*cos(degToRad(2.5)) };
yw  #eval{ 8.0*sin(degToRad(2.5)) };

vertices
(
    (0 0 -8)
    ($xw #eval{-$yw} -8)
    ($xw $yw -8)
    (0 0 8)
    ($xw #eval{-$yw} 8)
    ($xw $yw 8)
);

blocks
(
    hex (0 1 2 0 3 4 5 3) (#eval{2*$nf} 1 #eval{4*$nf})
    simpleGrading
    (
        ((1 $nf 1) (7 $nf 12))                     // r
        1
        ((7 $nf #eval{1.0/12}) (2 #eval{2*$nf} 1) (7 $nf 12))   // z
    )
);

boundary
(
    front  { type wedge; faces ((0 1 4 3)); }
    back   { type wedge; faces ((0 3 5 2)); }
    side   { type wall;  faces ((1 2 5 4)); }
    top    { type wall;  faces ((3 4 5 3)); }
    bottom { type wall;  faces ((0 2 1 0)); }
    axis   { type empty; faces ((0 3 3 0)); }
);
