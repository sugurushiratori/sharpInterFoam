FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    "(side|top|bottom)" { type fixedFluxPressure; value uniform 0; }
    "(front|back)"      { type wedge; }
    axis                { type empty; }
}
